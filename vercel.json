{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/check",
      "destination": "/api/check"
    },
    {
      "source": "/api/inspect-link",
      "destination": "/api/inspect-link"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/knowledge-base",
      "destination": "/api/knowledge-base"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
